# Cloudflare & CDN Universal Cache-Control Rules for Haat Bazar
# Prevents stale Facebook, Messenger, WhatsApp, and browser cache while accelerating immutable assets

# Default for HTML documents and root pages: always revalidate, never serve stale bundles
/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed immutable assets (Vite production builds)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker must always be fresh
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Web app manifest
/manifest.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
